```{=html}
<!-- lodash template: the dash tag escapes, the equals tag is raw (descriptions arrive as HTML) -->
<div class="list notebook-feed">
<% for (const item of items) { %>
  <a class="nb-post" href="<%- item.path %>" <%= metadataAttrs(item) %>>
    <span class="nb-title"><%- item.title %></span>
    <% if (item.subtitle) { %><span class="nb-sub"><%- item.subtitle %></span><% } %>
    <span class="nb-meta">
      <span class="nb-topic" aria-hidden="true"></span>
      <% if (item.date) { %><span><%- item.date %></span><% } %>
      <% if (item['reading-time']) { %><span><%- item['reading-time'] %></span><% } %>
      <% if (item.categories) { %><span class="nb-tags"><%- item.categories.map(c => '#' + c).join(' ') %></span><% } %>
    </span>
    <% if (item.description) { %><span class="nb-ex"><%= item.description %></span><% } %>
  </a>
<% } %>
</div>
```
